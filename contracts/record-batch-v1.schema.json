        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "record_id",
        "member_id",
        "type",
        "category",
        "amount",
        "currency",
        "source",
        "valid_from",
        "confidence"
      ],
      "title": "FinancialRecord",
      "type": "object"
    },
    "Source": {
      "additionalProperties": true,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "document_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "document_id",
        "filename"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "description": "Incremental push from the Financial Data Engine (e.g. a newly processed document).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "family_id": {
      "title": "Family Id",
      "type": "string"
    },
    "financial_records": {
      "items": {
        "$ref": "#/$defs/FinancialRecord"
      },
      "title": "Financial Records",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "family_id",
    "financial_records"
  ],
  "title": "RecordBatch",
  "type": "object"
}