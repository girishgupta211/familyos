        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "institution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution"
        }
      },
      "required": [
        "entity_type",
        "name"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "FinancialRecord": {
      "additionalProperties": true,
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "member_id": {
          "title": "Member Id",
          "type": "string"
        },
        "co_owner_ids": {
          "items": {
            "type": "string"
          },
          "title": "Co Owner Ids",
          "type": "array"
        },
        "type": {
          "enum": [
            "income",
            "expense",
            "bank_balance",
            "investment",
            "insurance",
            "loan",
            "asset",
            "liability",
            "transaction",
            "tax"
          ],
          "title": "Type",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "frequency": {
          "anyOf": [
            {
              "enum": [
                "monthly",
                "quarterly",
                "annual",
                "one_time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
